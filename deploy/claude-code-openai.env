# Claude Code through the router on the GPT-5.6 ladder (deploy/router.yaml), billed to
# OPENAI_API_KEY. Verified end to end; useful for testing the plumbing without Anthropic access.
# Anthropic does not support routing Claude Code to non-Claude models, so expect rougher agentic
# behaviour than on Claude tiers.
#   make up && source deploy/claude-code-openai.env && claude
export ANTHROPIC_BASE_URL=http://127.0.0.1:4000
export ANTHROPIC_AUTH_TOKEN=${LITELLM_MASTER_KEY:-sk-change-me}
export ANTHROPIC_MODEL=jev-auto
export ANTHROPIC_DEFAULT_HAIKU_MODEL=luna       # background calls go straight to luna, unrouted
export CLAUDE_CODE_DISABLE_EXPERIMENTAL_BETAS=1  # fewer Anthropic-only fields for LiteLLM to bridge
unset ANTHROPIC_API_KEY
