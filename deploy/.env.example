# Copy to deploy/.env. docker compose loads this file into the proxy container.

# Jev (TypeSafe) — required. The router judges every turn with it.
TYPESAFE_API_KEY=

# Providers — one per model family used in deploy/config.yaml. The default ladder is OpenAI only.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Bearer token clients send to the proxy. Change it before exposing the proxy beyond localhost.
LITELLM_MASTER_KEY=sk-change-me
