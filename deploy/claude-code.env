# Claude Code through the router on your claude.ai subscription. Source before running `claude`:
#   ROUTER_CONFIG=router.claude-code.yaml make up && source deploy/claude-code.env && claude
#
# Claude Code keeps its claude.ai login as the credential because no ANTHROPIC_AUTH_TOKEN or
# ANTHROPIC_API_KEY is set; the proxy is authenticated separately through the custom header and
# forwards the login's OAuth token to Anthropic. Usage counts against the subscription.
export ANTHROPIC_BASE_URL=http://127.0.0.1:4000
export ANTHROPIC_CUSTOM_HEADERS="x-litellm-api-key: Bearer ${LITELLM_MASTER_KEY:-sk-change-me}"
export ANTHROPIC_MODEL=jev-auto
export ANTHROPIC_DEFAULT_HAIKU_MODEL=haiku      # background calls go straight to haiku, unrouted
unset ANTHROPIC_API_KEY ANTHROPIC_AUTH_TOKEN
